# =============================================================================
# ENGYNE BACKEND — ENVIRONMENT VARIABLES (TEMPLATE)
# Copy to .env and fill. Never commit real secrets.
# =============================================================================

# --- 1) APP (REQUIRED) ---
APP_NAME=Engyne
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEVICE_TOKEN_EXPIRE_DAYS=365

# --- 2) SUPABASE DATABASE (REQUIRED for cloud) ---
# Settings → Database → Connection string (URI). Prefer pooler :6543
# DATABASE_URL=sqlite:///./engyne.db
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_PROJECT_REF=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# --- 3) SUPABASE API KEYS (OPTIONAL for current stack; keep for later) ---
# Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- 4) CORS (REQUIRED for admin SPA) ---
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- 5) ADMIN BOOTSTRAP (REQUIRED) ---
ADMIN_EMAIL=admin@engyne.example
ADMIN_PASSWORD=changeme123

# --- 6) EMAIL (OPTIONAL in dev) ---
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@engyne.example
ADMIN_REPORT_EMAIL=ops@engyne.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- 7) RAZORPAY (OPTIONAL until live payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- 8) INVOICE / COMPANY ---
INVOICE_PREFIX=ENGY
TAX_RATE_PERCENT=18
COMPANY_NAME=Engyne
COMPANY_ADDRESS=
COMPANY_GSTIN=

# --- 9) REDIS (OPTIONAL) ---
REDIS_URL=

# --- 10) EXTENSION BOUNDS ---
REFRESH_INTERVAL_MIN=15
REFRESH_INTERVAL_MAX=300
